<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/monetization_ads_sponsored_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/monetization_ads_internal_sponsored_container_side_padding"
        android:paddingTop="@dimen/monetization_ads_internal_sponsored_container_top_padding"
        android:paddingEnd="@dimen/monetization_ads_internal_sponsored_container_side_padding">

        <TextView
            android:id="@+id/monetization_ads_sponsored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/monetization_ads_internal_sponsored_text_color"
            android:textSize="@dimen/monetization_ads_internal_sponsored_text_size"
            android:visibility="gone"
            tools:text="@string/monetization_ads_internal_tools_sponsored_text"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/monetization_ads_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/monetization_ads_internal_age_text_color"
            android:textSize="@dimen/monetization_ads_internal_age_text_size"
            android:visibility="gone"
            tools:text="@string/monetization_ads_internal_tools_age_text"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/monetization_ads_body_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/monetization_ads_internal_body_container_top_margin"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="@dimen/monetization_ads_internal_body_container_side_padding"
        android:paddingRight="@dimen/monetization_ads_internal_body_container_side_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.monetization.ads.fullscreen.template.view.RoundImageView
                android:id="@+id/monetization_ads_icon"
                android:layout_width="@dimen/monetization_ads_internal_icon_size"
                android:layout_height="@dimen/monetization_ads_internal_icon_size"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/monetization_ads_internal_icon_margin_end"
                android:layout_marginRight="@dimen/monetization_ads_internal_icon_margin_end"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:monetization_internal_corner_radius="32dp"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/monetization_ads_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="@integer/monetization_ads_internal_title_max_lines"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/monetization_ads_internal_title_text_size"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="@string/monetization_ads_internal_tools_title_text"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/monetization_ads_domain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="@integer/monetization_ads_internal_domain_max_lines"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="@dimen/monetization_ads_internal_domain_text_size"
                    android:visibility="gone"
                    tools:text="@string/monetization_ads_internal_tools_domain_text"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/monetization_ads_internal_details_container_top_margin"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/monetization_ads_rating_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.monetization.ads.fullscreen.template.view.ColorizedRatingView
                            android:id="@+id/monetization_ads_rating"
                            style="@style/MonetizationAdsInternal.RatingBar.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/monetization_ads_internal_rating_margin_end"
                            android:layout_marginRight="@dimen/monetization_ads_internal_rating_margin_end"
                            android:numStars="@integer/monetization_ads_internal_rating_num_stars"
                            android:stepSize="@dimen/monetization_ads_internal_rating_step_size"
                            android:visibility="gone"
                            tools:rating="@dimen/monetization_ads_internal_rating_tools_value"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/monetization_ads_review_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/monetization_ads_internal_review_count_margin_end"
                            android:layout_marginRight="@dimen/monetization_ads_internal_review_count_margin_end"
                            android:ellipsize="end"
                            android:maxLines="@integer/monetization_ads_internal_review_count_max_lines"
                            android:textColor="@color/monetization_ads_internal_review_count_text_color"
                            android:textSize="@dimen/monetization_ads_internal_review_count_text_size"
                            android:visibility="gone"
                            tools:text="@string/monetization_ads_internal_tools_review_count_text"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/monetization_ads_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="@integer/monetization_ads_internal_price_max_lines"
                        android:textColor="@color/monetization_ads_internal_price_text_color"
                        android:textSize="@dimen/monetization_ads_internal_price_text_size"
                        android:visibility="gone"
                        tools:text="@string/monetization_ads_internal_tools_price_text"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/monetization_ads_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/monetization_ads_internal_body_margin_top"
            android:maxLines="@integer/monetization_ads_internal_body_max_lines"
            android:textColor="@android:color/black"
            android:textSize="@dimen/monetization_ads_internal_body_text_size"
            android:visibility="gone"
            android:ellipsize="end"
            tools:text="@string/monetization_ads_internal_tools_body_text"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/monetization_ads_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/monetization_ads_internal_warning_margin_top"
            android:ellipsize="end"
            android:maxLines="@integer/monetization_ads_internal_warning_max_lines"
            android:textColor="@color/monetization_ads_internal_warning_text_color"
            android:textSize="@dimen/monetization_ads_internal_warning_text_size"
            android:visibility="gone"
            tools:text="@string/monetization_ads_internal_tools_warning_text"
            tools:visibility="visible" />

    </LinearLayout>

    <com.monetization.ads.fullscreen.template.view.CallToActionView
        android:id="@+id/monetization_ads_call_to_action"
        style="@style/MonetizationAdsInternal.CallToAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/monetization_ads_internal_call_to_action_margin"
        android:background="@drawable/monetization_ads_internal_call_to_action_background"
        android:visibility="gone"
        android:textSize="18sp"
        android:textColor="@color/monetization_ads_internal_call_to_action_text_color_black"
        tools:text="@string/monetization_ads_internal_tools_call_to_action_text"
        tools:visibility="visible" />

</LinearLayout>
