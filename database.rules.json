{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "created": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$slot": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && ($slot === 'w' || $slot === 'b')"
          }
        },
        "commit": {
          "$slot": {
            ".write": "auth != null && !data.exists() && newData.isString() && newData.parent().parent().child('players').child($slot).val() === auth.uid"
          }
        },
        "online": {
          "$slot": {
            ".write": "auth != null && (newData.parent().parent().child('players').child($slot).val() === auth.uid || data.parent().parent().child('players').child($slot).val() === auth.uid)"
          }
        },
        "log": {
          "$n": {
            ".write": "auth != null && !data.exists() && ((newData.child('p').val() === 0 && root.child('rooms').child($room).child('players').child('w').val() === auth.uid) || (newData.child('p').val() === 1 && root.child('rooms').child($room).child('players').child('b').val() === auth.uid))",
            ".validate": "newData.child('t').isString() && newData.child('p').isNumber()"
          }
        },
        "names": {
          "$slot": {
            ".write": "auth != null && newData.parent().parent().child('players').child($slot).val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 24"
          }
        },
        "head2": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isBoolean()"
        },
        "v": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === 'short' || newData.val() === 'long'"
        },
        "emo": {
          "$slot": {
            ".write": "auth != null && newData.parent().parent().child('players').child($slot).val() === auth.uid",
            ".validate": "newData.child('e').isNumber() && newData.child('e').val() >= 0 && newData.child('e').val() < 12 && newData.child('t').isNumber()"
          }
        }
      }
    },
    "players": {
      ".read": "auth != null",
      ".indexOn": [
        "r",
        "rs"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('r').isNumber() && newData.child('g').isNumber() && ((!data.child('r').exists() && newData.child('r').val() >= 1152 && newData.child('r').val() <= 1248 && newData.child('g').val() >= 0 && newData.child('g').val() <= 1) || (data.child('r').exists() && ((newData.child('r').val() === data.child('r').val() && newData.child('g').val() === data.child('g').val()) || (newData.child('g').val() === data.child('g').val() + 1 && newData.child('r').val() - data.child('r').val() <= 48 && data.child('r').val() - newData.child('r').val() <= 48))))",
        "rs": {
          ".validate": "newData.isNumber() && newData.parent().child('gs').isNumber() && ((!data.exists() && newData.val() >= 1152 && newData.val() <= 1248 && newData.parent().child('gs').val() >= 0 && newData.parent().child('gs').val() <= 1) || (data.exists() && ((newData.val() === data.val() && newData.parent().child('gs').val() === data.parent().child('gs').val()) || (newData.parent().child('gs').val() === data.parent().child('gs').val() + 1 && newData.val() - data.val() <= 48 && data.val() - newData.val() <= 48))))"
        }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)",
          ".validate": "!newData.exists() || (newData.child('room').isString() && newData.child('name').isString() && newData.child('name').val().length <= 24)"
        }
      }
    },
    "reports": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 1500 && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length < 900000)) && (!newData.child('pics').exists() || !newData.child('pics').child('3').exists())",
        "pics": {
          "$n": {
            ".validate": "newData.isString() && newData.val().length < 400000"
          }
        }
      }
    },
    "stats": {
      ".read": "auth != null",
      "u": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('l').isNumber() && newData.child('p').isString() && newData.child('p').val().length <= 10 && (!data.child('f').exists() || newData.child('f').val() === data.child('f').val())"
        }
      },
      "d": {
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        }
      },
      "g": {
        "$day": {
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.child('m').isString() && newData.child('m').val().length <= 10"
          }
        }
      }
    },
    "weekly": {
      "$week": {
        ".read": "auth != null",
        ".indexOn": [
          "p"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$week.length <= 10 && newData.child('n').isString() && newData.child('n').val().length <= 24 && newData.child('p').isNumber() && newData.child('p').val() >= 0 && newData.child('p').val() <= 400 && newData.child('t').isNumber()"
        }
      }
    }
  }
}