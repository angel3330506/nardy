<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/monetization_ads_internal_sponsored_container_background"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/monetization_ads_sponsored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="@integer/monetization_ads_internal_domain_max_lines"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="@string/monetization_ads_internal_tools_sponsored_text"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/monetization_ads_age_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/monetization_ads_internal_text_divider"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/monetization_ads_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="@integer/monetization_ads_internal_age_max_lines"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="@string/monetization_ads_internal_tools_age_text"
            tools:visibility="visible" />

    </LinearLayout>

</merge>
