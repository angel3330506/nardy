<?xml version="1.0" encoding="utf-8"?>
<com.monetization.ads.video.playback.view.ExtendedVideoAdControlsContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:tag="video_ad_container"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:layout_height="300dp">

    <FrameLayout
        android:id="@+id/monetization_ads_video_container"
        android:background="@color/monetization_ads_internal_instream_video_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/monetization_ads_sponsored_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/monetization_instream_internal_label_margin_start"
        android:layout_marginLeft="@dimen/monetization_instream_internal_label_margin_start"
        android:layout_marginTop="@dimen/monetization_instream_internal_label_margin_top"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/monetization_instream_internal_button_margin_start"
        android:layout_marginLeft="@dimen/monetization_instream_internal_button_margin_start"
        android:layout_marginBottom="@dimen/monetization_instream_internal_button_margin_bottom">

        <com.monetization.ads.instream.view.InstreamMuteView
            android:id="@+id/monetization_ads_instream_mute"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/monetization_instream_internal_button_size"
            android:layout_height="@dimen/monetization_instream_internal_button_size"
            android:layout_gravity="center"
            android:focusable="true"
            android:nextFocusRight="@id/monetization_ads_instream_call_to_action"
            app:monetization_internal_sound_off="@drawable/monetization_ads_internal_ic_sound_off_default"
            app:monetization_internal_sound_on="@drawable/monetization_ads_internal_ic_sound_on_default"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/monetization_ads_instream_call_to_action"
            android:focusable="true"
            android:nextFocusLeft="@id/monetization_ads_instream_mute"
            android:nextFocusRight="@id/monetization_ads_instream_skip"
            style="?android:attr/borderlessButtonStyle"
            android:tag="instream_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/monetization_instream_internal_button_size"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/monetization_instream_internal_button_margin_start"
            android:layout_marginLeft="@dimen/monetization_instream_internal_button_margin_start"
            android:background="@drawable/monetization_ads_internal_instream_call_to_action_image_background"
            tools:ignore="ContentDescription" />

    </LinearLayout>


    <ProgressBar
        android:id="@+id/monetization_ads_instream_progress_display_view"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/monetization_instream_internal_progress_bar_height"
        android:layout_gravity="bottom"
        android:max="@integer/monetization_instream_internal_progress_bar_max"
        android:progressDrawable="@drawable/monetization_ads_instream_internal_progress_display" />

    <ImageView
        android:id="@+id/monetization_ads_instream_skip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/monetization_instream_internal_button_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/monetization_instream_internal_button_margin_end"
        android:layout_marginRight="@dimen/monetization_instream_internal_button_margin_end"
        android:layout_marginBottom="@dimen/monetization_instream_internal_button_margin_bottom"
        android:background="@drawable/monetization_ads_instream_internal_skip"
        android:visibility="gone"
        android:focusable="true"
        android:nextFocusLeft="@id/monetization_ads_instream_call_to_action"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

</com.monetization.ads.video.playback.view.ExtendedVideoAdControlsContainer>
